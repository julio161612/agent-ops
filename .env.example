# Root-level env file for `docker compose up` — Docker Compose automatically
# reads a .env file next to docker-compose.yml to fill in the ${VAR}
# placeholders below. This is separate from backend/.env.example and
# frontend/.env.example, which configure each app when run outside Docker
# (e.g. `uvicorn` or `npm run dev` directly on your machine).
#
# Usage: cp .env.example .env, then fill in ANTHROPIC_API_KEY, then:
#   docker compose up --build
#
# NEVER commit the real .env — only this .example file belongs in git.

# Required to actually run agents for real (AgentExecutionService calls
# Anthropic). Without it, everything else still works — agent test/execution
# calls will just fail with an upstream auth error.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides — safe defaults are used if left unset, fine for local
# use. Generate a real secret for anything resembling a shared/public
# deployment: `openssl rand -hex 32`.
JWT_SECRET_KEY=local-dev-secret-change-me
POSTGRES_PASSWORD=agentops

# Host ports (change if 8000/8080 are taken by another project)
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Allowed browser origins for the API, as a JSON array. Optional: defaults to
# http://localhost:${FRONTEND_PORT}. Not needed when browsing through nginx
# (single origin); needed only for cross-origin callers.
# BACKEND_CORS_ORIGINS=["http://localhost:8080"]

# Run `alembic upgrade head` when the backend container starts (default true).
# Set to false to migrate separately: docker compose --profile tools run --rm migrate
# RUN_MIGRATIONS_ON_START=true
