# Serves the built React SPA and reverse-proxies every backend-owned path to
# ${BACKEND_URL} (an nginx image template: the official entrypoint runs envsubst
# over /etc/nginx/templates/*.template at container start). Defaults to the
# Docker Compose service; in Azure Container Apps set it to the internal app,
# e.g. http://agentops-dev-backend. "Host" is sent as the upstream's own host
# ($proxy_host) because Container Apps routes internal traffic by Host header.
# The browser only ever calls this single origin — no CORS configuration needed
# in production, mirroring what the Vite dev-server proxy already does in
# local development (see ../vite.config.ts).

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA routing: any path that isn't a real file falls back to index.html
    # so React Router can handle it client-side (e.g. a hard refresh on
    # /agents shouldn't 404 at the web server level).
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The public API used by the embeddable widget (Phase 9) — authenticated
    # with an X-API-Key header, not a browser session, so it needs the same
    # single-origin treatment as /api/ for the widget snippet to work as-is.
    location /public/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /widget.js {
        proxy_pass ${BACKEND_URL};
    }

    # Static assets get a long cache lifetime — Vite fingerprints filenames
    # on every build, so a stale cache just means an old, still-valid file.
    location ~* \.(?:js|css|woff2?|svg|png|jpg|jpeg|gif|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
