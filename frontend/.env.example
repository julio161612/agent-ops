# Optional. In local development you normally don't need this at all — the
# Vite dev server proxies /api/* to the backend (see vite.config.ts), so the
# frontend never needs to know the backend's real URL.
#
# Set this only when:
#   - the backend runs on a different host/port than the proxy target in
#     vite.config.ts, or
#   - you're building a production bundle that must call the backend
#     directly (no dev-server proxy exists in a static build).
#
# Must include the /api/v1 prefix, e.g.:
# VITE_API_BASE_URL=http://localhost:8000/api/v1
