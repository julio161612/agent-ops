# General
PROJECT_NAME="Agent Ops"
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# Database (async SQLAlchemy URL, asyncpg driver)
DATABASE_URL=postgresql+asyncpg://agentops:agentops@localhost:5432/agentops
DATABASE_URL_TEST=postgresql+asyncpg://agentops:agentops@localhost:5432/agentops_test
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_URL_TEST=redis://localhost:6379/1

# Auth / JWT — generate a strong random value for production, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — a JSON array string, not a comma-separated list (pydantic-settings
# parses list-typed settings from .env as JSON). Only needed if the frontend
# is served from an origin other than the defaults below.
# BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Anthropic — required to actually run agents (AgentExecutionService).
# Get a key at https://console.anthropic.com/settings/keys
# NEVER commit a real key — this file is the template, not where the key lives.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_SECONDS=60

# Routing — below this confidence, the LLM router's pick is discarded and the
# conversation is left unassigned (ready to be escalated to a human in Phase 5).
ROUTING_CONFIDENCE_THRESHOLD=0.5

# Guardrails — cheap/fast model used for custom_llm_check policies by default.
GUARDRAIL_LLM_MODEL=claude-haiku-4-5-20251001

# Tenant limits — defaults applied to new tenants at registration time.
DEFAULT_MESSAGES_PER_MINUTE_LIMIT=60
# DEFAULT_MONTHLY_COST_LIMIT_USD=50.0   # unset/empty = unlimited

# Public API (Phase 9) — per-API-key rate limit for end-customer traffic via
# /public/v1, stricter by default than internal JWT-authenticated traffic.
PUBLIC_API_RATE_LIMIT_PER_MINUTE=20

# Slack webhook call timeout, in seconds (Phase 9 escalation notifications).
SLACK_WEBHOOK_TIMEOUT_SECONDS=10
